{
  "name": "rrhh-backend",
  "version": "1.0.0",
  "description": "API Backend - Sistema Control Asistencia Biométrica Hospital 24h",
  "main": "dist/src/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "db:setup": "psql -U postgres -f ../database/schema.sql",
    "db:seed": "ts-node scripts/seed.ts",
    "db:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "biometric",
    "attendance",
    "hospital",
    "Ecuador",
    "RRHH"
  ],
  "author": "RRHH Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/jwt": "^7.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@prisma/client": "^5.4.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "prisma": "^5.4.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.2.2"
  }
}
