# === ENVIRONMENT VARIABLES ===
# Copiar a .env y llenar con valores reales

# === DATABASE ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rrhh_hospital
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSL=true

# === API ===
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# === JWT ===
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# === BIOMETRIC DEVICES ===
BIOMETRIC_ZK_HOST=192.168.1.100
BIOMETRIC_ZK_PORT=8200
BIOMETRIC_FACIAL_ENABLED=true
BIOMETRIC_FACIAL_API=http://localhost:5000

# === SECURITY ===
ENCRYPTION_KEY=your_encryption_key
BCRYPT_ROUNDS=10

# === LOGGING ===
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# === CORS ===
CORS_ORIGIN=http://localhost:3001

# === EMAIL (para notificaciones) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# === HOSPITAL ===
HOSPITAL_NAME=Hospital 24 Horas
HOSPITAL_TIMEZONE=America/Guayaquil
BUSINESS_DAYS=LUNES|MARTES|MIERCOLES|JUEVES|VIERNES|SABADO|DOMINGO
